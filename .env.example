# Copy to backend/.env (or set in your shell / host). Only DATABASE_URL is required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aknologia?sslmode=disable
APP_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:8080
PORT=8080
DEV_MODE=true                 # prints emails and one-time codes to the log; set false in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Aknologia <no-reply@yourco.com>
DOWNLOAD_URL=                 # defaults to $PUBLIC_URL/download/
SYNC_MINUTE=0                 # minute past the hour when desktop agents sync
MIN_AGENT_VERSION=1.0.0
CORS_ORIGINS=
TRUSTED_PROXY_HOPS=0          # proxies in front of the server that append X-Forwarded-For (Render: 1)
