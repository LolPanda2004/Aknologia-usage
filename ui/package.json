{
  "name": "aknologia-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:admin": "vite --config vite.admin.config.ts",
    "dev:desktop": "vite --config vite.desktop.config.ts",
    "build:admin": "tsc --noEmit && vite build --config vite.admin.config.ts",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.ts",
    "build": "npm run build:admin && npm run build:desktop",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
